{
  "name": "spendo",
  "version": "0.1.0",
  "description": "Spendo — Banking Hub by arfly for private Banking-as-a-Service across arfly SaaS apps",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json && cp -R src/db/migrations dist/db/migrations",
    "start": "node dist/index.js",
    "start:prod": "node dist/db/migrate.js && node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts",
    "bootstrap": "tsx src/cli/bootstrap.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "worker": "tsx src/workers/run.ts",
    "db:generate": "drizzle-kit generate",
    "web": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "web:install": "npm install --prefix web",
    "dev:all": "sh -c 'npm run dev & npm run web & wait'",
    "build:all": "npm run build && npm run web:build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rzaccardi/arfly-spendo.git"
  },
  "keywords": [
    "spendo",
    "arfly",
    "banking",
    "baas",
    "fintable"
  ],
  "author": "arfly",
  "license": "UNLICENSED",
  "dependencies": {
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@fastify/swagger": "^9.5.1",
    "@fastify/swagger-ui": "^5.2.3",
    "argon2": "^0.43.1",
    "dotenv": "^16.6.1",
    "drizzle-orm": "^0.44.5",
    "fastify": "^5.5.0",
    "node-cron": "^4.2.1",
    "pino": "^9.9.0",
    "postgres": "^3.4.7",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/node-cron": "^3.0.11",
    "drizzle-kit": "^0.31.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
