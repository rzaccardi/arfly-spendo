# Spendo Banking Hub — copy to .env and fill in
# Never commit real .env, Fintable PATs, or spk_ keys.
# Production (DigitalOcean App Platform): set these as Encrypted env vars — see docs/deploy-digitalocean.md

# Postgres (local: matches docker-compose.yml)
# Production: bind from DO managed DB (${spendo-db.DATABASE_URL}) or paste managed connection string as SECRET
# Managed DO: append ?sslmode=require (client also adds it for non-localhost hosts)
DATABASE_URL=postgresql://spendo:spendo@localhost:5432/spendo

# 32-byte key as hex (64 chars) or base64 — AES-256-GCM for Fintable PATs + webhook secrets
# Generate: openssl rand -hex 32
# Required in every environment; rotate carefully (re-encrypt stored secrets if changed)
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Fintable (optional for dry-run; required for live sync, e.g. History workspace)
# Production: SECRET on App Platform — do not bake into Docker image; connections live in DB after seed/UI
FINTABLE_API_TOKEN=
FINTABLE_BASE_URL=https://fintable.io/api/v2

# Sync schedule (node-cron). Default: every 15 minutes
SYNC_CRON=*/15 * * * *

# Outbound webhook delivery worker (default: every minute)
WEBHOOK_DELIVERY_CRON=* * * * *

# HTTP
# Local default 3000; Docker / App Platform typically PORT=8080 (HOST=0.0.0.0)
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info
# development | production — production serves Admin SPA from web/dist and sets Secure cookies
NODE_ENV=development

# When true, sync skips live Fintable HTTP calls (tests / local without token)
# If FINTABLE_API_TOKEN is empty, dry-run is forced regardless of this flag
FINTABLE_DRY_RUN=false

# Rate limit (requests per minute per API key)
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_TIME_WINDOW_MS=60000

# Admin UI (/admin/api + web/) — operators only, separate from SaaS spk_ keys
# Set at least one of ADMIN_PASSWORD (cookie login) or ADMIN_API_KEY / ADMIN_TOKEN (Bearer)
# Production: both ADMIN_PASSWORD and ADMIN_API_KEY as App Platform SECRETs
ADMIN_PASSWORD=change-me-admin
ADMIN_API_KEY=
# ADMIN_TOKEN is an alias for ADMIN_API_KEY
ADMIN_SESSION_TTL_HOURS=12

# Admin SPA (Vite): in production same-origin serving needs no VITE_* URL.
# Only set if you split static hosting onto another origin (then configure CORS separately):
# VITE_API_BASE_URL=https://api.example.com
